rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PC-12: outfits and their facts are owner-only, same as items.
    // style_profile is a single doc per user (doc id == user id).
    match /users/{userId}/items/{itemId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/outfits/{outfitId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/wear_events/{eventId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    // OBS-1: client error reports. Owner can create only — reads happen
    // admin-side (metrics script / console), never via the app.
    match /users/{userId}/client_errors/{errorId} {
      allow create:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.where is string
        && request.resource.data.where.size() <= 120
        && (!("code" in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 80))
        && (!("message" in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 500));
      allow read, update, delete: if false;
    }
    // Sprint 15 (PC-29 Phase 1): trips. Owner-only, full CRUD — the packing
    // object is generated client-side from the planPacking callable and
    // written as one field, so no per-field write restrictions.
    match /users/{userId}/trips/{tripId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    // Sprint 17 (CONTEXT PINS): confirmed current facts — location,
    // weather, preferences. Owner-only CRUD; kind is a fixed enum and
    // the label is short (detail lives in the prose fields).
    match /users/{userId}/context_pins/{pinId} {
      allow read, delete:
        if request.auth != null && request.auth.uid == userId;
      allow create, update:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.kind in ["location", "weather", "preference"]
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80;
    }
    // DESIGN-HOME-1 (fix buffer 5): Today's daily picks + app settings
    // live server-side so every device sees the same Today. Owner-only.
    match /users/{userId}/today_picks/{dayId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/settings/{settingId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/ratings/{ratingId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/style_profile/{profileId} {
      allow read, create, update, delete:
        if request.auth != null && request.auth.uid == userId;
    }
    // PC-28: saved shop checks. Owner-only. The AI analysis (score,
    // verdict, reasons, similarOwned, outfits, item) is written once at
    // save time; updates may only touch the user's own fields
    // (userNote, link, sku, status, updatedAt).
    match /users/{userId}/shopChecks/{checkId} {
      allow read, delete:
        if request.auth != null && request.auth.uid == userId;
      allow create:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.photoPath is string
        && request.resource.data.photoPath.size() > 0
        && request.resource.data.photoPath.size() <= 300
        && request.resource.data.status in ["considering", "bought", "dismissed"]
        && (request.resource.data.score == null
            || (request.resource.data.score is number
                && request.resource.data.score >= 0
                && request.resource.data.score <= 10))
        && (!("userNote" in request.resource.data) || (request.resource.data.userNote is string && request.resource.data.userNote.size() <= 500))
        && (!("link" in request.resource.data) || (request.resource.data.link is string && request.resource.data.link.size() <= 500))
        && (!("sku" in request.resource.data) || (request.resource.data.sku is string && request.resource.data.sku.size() <= 100))
        // Sprint 15: trip tag (Phase 3 UI; field exists from day one).
        && (!("tripId" in request.resource.data) || (request.resource.data.tripId == null || (request.resource.data.tripId is string && request.resource.data.tripId.size() <= 100)));
      allow update:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["userNote", "link", "sku", "status", "updatedAt", "addedItemId", "tripId"])
        && request.resource.data.status in ["considering", "bought", "dismissed"]
        && (!("userNote" in request.resource.data) || (request.resource.data.userNote is string && request.resource.data.userNote.size() <= 500))
        && (!("link" in request.resource.data) || (request.resource.data.link is string && request.resource.data.link.size() <= 500))
        && (!("sku" in request.resource.data) || (request.resource.data.sku is string && request.resource.data.sku.size() <= 100))
        && (!("tripId" in request.resource.data) || (request.resource.data.tripId == null || (request.resource.data.tripId is string && request.resource.data.tripId.size() <= 100)))
        && (!("addedItemId" in request.resource.data) || (request.resource.data.addedItemId is string && request.resource.data.addedItemId.size() <= 100));
    }
    // Sprint 13: the learned vibe profile lives on the user doc itself
    // (users/{userId}). Owner-only; only the vibeProfile map may be
    // written, so the doc can't become a junk drawer. Does not affect
    // subcollections — more specific matches win.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["vibeProfile", "updatedAt"])
        && request.resource.data.vibeProfile is map;
      allow update:
        if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vibeProfile", "updatedAt"])
        && (!("vibeProfile" in request.resource.data) || request.resource.data.vibeProfile is map);
      allow delete: if false;
    }
    // FB-1: beta feedback. Any signed-in user can submit; nobody reads via
    // the client (triage happens in the console / admin SDK). Write-only
    // keeps tester identities out of each other's reach.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000;
      allow read, update, delete: if false;
    }
  }
}
